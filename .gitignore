# ---- data ----
# Raw corpora and derived artefacts are downloaded, never committed.
# SOURCES.md is the exception: it records where the data came from, which is
# the part that must survive in the repository.
data/*
!data/raw/
data/raw/*
!data/raw/SOURCES.md
*.jsonl
*.jsonl.gz
*.csv.gz

# ---- models ----
# The trained model is a build output. See ml_api/README for how to rebuild it.
*.npz

# ---- databases ----
# Django is gone, but a stray db.sqlite3 was committed once when this section
# was removed while an untracked one sat on disk. Keeping a generic rule.
*.sqlite3
*.sqlite3-journal
*.db

# ---- python ----
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- node / next ----
node_modules/
.next/
out/
.vercel/
*.tsbuildinfo
next-env.d.ts

# ---- env & secrets ----
.env
.env.*
!.env.example

# ---- editors / os ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- local reference captures ----
/screenshots/
