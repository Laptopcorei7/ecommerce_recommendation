# Copy to backend/ecommerce_recommender/.env and edit.
# Never commit the real .env; .gitignore already blocks it.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# The model service. Must not be 8000, which Django's runserver uses.
MODEL_SERVICE_URL=http://127.0.0.1:8001
MODEL_SERVICE_TIMEOUT=5

# Origins allowed to call this gateway from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
